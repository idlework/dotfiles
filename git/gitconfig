[include]
	path = ~/.gitconfig.local
[includeIf "gitdir:~/Development/me/dotfiles/"]
	path = ~/Development/me/dotfiles/git/identity
[core]
	editor = zed --wait
[alias]
	lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
[init]
	defaultBranch = main
[url "git@github.com:"]
	insteadOf = git@github-
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
