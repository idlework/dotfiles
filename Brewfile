# Installed by ./install.sh via `brew bundle`. Only what the managed files need.

# Neovim toolchain (LazyVim requirements)
brew "neovim"            # LazyVim needs >= 0.11.2
brew "git"
brew "ripgrep"           # grep picker
brew "fd"                # files picker
brew "fzf"               # LazyVim health check
brew "lazygit"           # <leader>gg
brew "gh"
brew "tree-sitter-cli"   # nvim-treesitter main branch compiles parsers with the CLI

# Sourced or referenced by the managed shell and git files
brew "nvm"
brew "rbenv"
brew "zsh-syntax-highlighting"
cask "gcloud-cli"              # .zshrc sources share/google-cloud-sdk unconditionally
cask "git-credential-manager"  # gitconfig credential.helper

# Terminal and font
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
